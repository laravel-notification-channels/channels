{
    "name": "laravel-notification-channels/sms-ir",
    "description": "sms.ir notifications channel for Laravel",
    "keywords": [
        "laravel",
        "notifications",
        "sms",
        "sms.ir",
        "smsir",
        "otp",
        "iran",
        "پیامک"
    ],
    "homepage": "https://github.com/laravel-notification-channels/sms-ir",
    "license": "MIT",
    "authors": [
        {
            "name": "Ali Sameni",
            "email": "ali@farsi.dev",
            "homepage": "https://github.com/aliwesome",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "farsi/laravel-smsir": "^1.1",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.2|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\SmsIr\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\SmsIr\\Test\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
