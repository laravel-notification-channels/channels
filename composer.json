{
    "name": "laravel-notification-channels/onewaysms",
    "description": "OneWaySMS notification channel for Laravel",
    "keywords": ["laravel", "notifications", "onewaysms", "one way sms", "sms", "malaysia", "message"],
    "homepage": "https://github.com/laravel-notification-channels/onewaysms",
    "license": "MIT",
    "authors": [
        {
            "name": "Hafiq Iqmal",
            "email": "hafiqiqmal93@gmail.com",
            "homepage": "https://github.com/afiqiqmal",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.5",
        "nunomaduro/collision": "^7.0|^8.1",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.1|^2.0",
        "phpstan/phpstan-phpunit": "^1.1|^2.0"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\OneWaySms\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\OneWaySms\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NotificationChannels\\OneWaySms\\OneWaySmsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
